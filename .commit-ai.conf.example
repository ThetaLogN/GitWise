# .commit-ai.conf — Example Configuration
# Place this file in the root of your git repository.
# Copy it first: cp .commit-ai.conf.example .commit-ai.conf

# Each value can be overridden with environment variables (COMMIT_AI_ prefix).

# Ollama model to use
# Env override: COMMIT_AI_MODEL
MODEL=qwen2.5-coder:7b

# Ollama API endpoint
# Env override: COMMIT_AI_URL
OLLAMA_URL=http://localhost:11434/api/generate

# Maximum diff length sent to the model (in characters)
# Env override: COMMIT_AI_MAX_DIFF
MAX_DIFF_LENGTH=3000

# Commit message language (en, it, es, fr, de)
# Env override: COMMIT_AI_LANGUAGE
LANGUAGE=en

# Timeout in seconds for Ollama response
# Env override: COMMIT_AI_TIMEOUT
TIMEOUT=120
